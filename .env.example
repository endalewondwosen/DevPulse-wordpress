# =============================================================================
# DevPulse Portfolio — environment template
# Copy to `.env` (local full-stack) or set vars in Vercel / Render dashboards.
# Never commit `.env` or `.env.local` (gitignored).
# =============================================================================

# -----------------------------------------------------------------------------
# Local development (`npm run dev` — API + Vite on one server, port 3000)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Leave empty so the app calls `/api` on the same origin:
# VITE_API_URL=

# Show “Login as Admin” in nav without being logged in (local only):
VITE_SHOW_ADMIN_LOGIN=true

# PostgreSQL (Neon, etc.) — omit to use SQLite file `devpulse.db`
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Auth (change these; use long random JWT_SECRET in production)
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-strong-password

# Optional: Gemini for Admin analytics report (server-side only)
GEMINI_API_KEY=

# Optional: public recruiter chat widget (Vercel only — exposes key in browser bundle)
# Prefer leaving unset in production unless you accept client-visible API usage limits.
# VITE_GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Render (API backend) — https://devpulse-wordpress.onrender.com
# -----------------------------------------------------------------------------
# NODE_ENV=production
# PORT=10000
# DATABASE_URL=postgresql://...
# JWT_SECRET=<openssl rand -hex 32>
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<strong-password>
# GEMINI_API_KEY=<google-ai-studio-key>
# PUBLIC_SITE_URL=https://wondwosenportifolio.vercel.app
# CORS_ORIGINS=https://your-custom-domain.com

# -----------------------------------------------------------------------------
# Vercel (static frontend) — build-time variables
# -----------------------------------------------------------------------------
# VITE_API_URL=https://devpulse-wordpress.onrender.com
# VITE_SHOW_ADMIN_LOGIN=false
# VITE_GEMINI_API_KEY=   # only if you enable the public AI chat widget
